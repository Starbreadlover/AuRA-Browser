# AuRA Browser macOS artifact build.
# Use for fast UI, JS, CSS, and branding iteration.
# A full build is required for C++ changes such as registering about:aura.

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-aura-macos-artifact

ac_add_options --enable-application=browser
ac_add_options --with-branding=browser/branding/aura
ac_add_options --with-distribution-id=io.aura
ac_add_options --enable-artifact-builds
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests

# Public macOS builds need AuRA-owned signing and notarization.
# Local builds can run through ./mach run without production signing.
